# --- scripts/deploy-kms.ts ---
# AWS KMS key id or ARN for an asymmetric ECC_SECG_P256K1 key. The caller's
# AWS credentials (default SDK credential chain) need kms:GetPublicKey and
# kms:Sign on this key.
KMS_KEY_ID=arn:aws:kms:ap-south-1:063103766789:key/74434fb1-197d-4159-b6ba-1f3fcbac9c61
# Optional - falls back to the default AWS SDK region resolution if unset.
AWS_REGION=ap-south-1

# Address (wallet or Safe) that will be set as the IdentityRegistry agent
# and runs Phase C's whitelist step independently.
REGISTRAR_ADDRESS=
# Address (wallet or Safe) that will be set as the Token agent and runs
# Phase C's mint/unpause/DVD-trade steps independently.
BND_ADDRESS=

# --- hardhat.config.ts (sepolia network) ---
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/alch_Hy4M3czQo502Ur8zu3WYj
DEPLOYER_PRIVATE_KEY=c29899faacb3556523421d6743d1d54fa0c03aebcd58685dedbdc78afe09e4c2

# --- scripts/deploy-sepolia.ts ---
# Full Phase A+B+C demo run on Sepolia. Every role below needs its own
# Sepolia ETH for gas (DEPLOYER_PRIVATE_KEY above is reused as Platform Admin).
REGISTRAR_PRIVATE_KEY=c29899faacb3556523421d6743d1d54fa0c03aebcd58685dedbdc78afe09e4c2
BND_PRIVATE_KEY=c29899faacb3556523421d6743d1d54fa0c03aebcd58685dedbdc78afe09e4c2
AURORA_PRIVATE_KEY=643638fa2b5b4275e5abe38cfe3732a7784074c6a885ef6986bdce62ebda2e4b
NORTHBRIDGE_PRIVATE_KEY=df66b41fb6abd7f3e84257f810cd9dbb05e61590a422475426d3d3f4e457d950
MERIDIAN_PRIVATE_KEY=6d1a9dd75dcd34fe919267c6efc963cf22d1a603201945ac0e23408be66e2253
